# Big 5 Matrix — environment configuration example.
#
# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# The backbone runs fully in-memory by default; these values are only required when using
# the Prisma-backed persistence (createRepositories('prisma')) or the Redis router stub.
# The defaults below match the services defined in docker-compose.yml.

# Postgres connection string used by Prisma (config/schema.prisma) and `npm run db:push`.
DATABASE_URL="postgresql://big5:big5@localhost:5432/big5_matrix?schema=public"

# Redis connection string used by the router / task-queue stub.
REDIS_URL="redis://localhost:6379"

# --- Optional LLM providers (providers/) ------------------------------------------------
# Fully OPTIONAL and offline-first: with none of these set, the deterministic StubProvider
# is used and everything works with no network and no API key. Providers only enrich TEXT
# (e.g. HOPE's intent summary); they NEVER execute, route, or create anything.
#
# Which provider to build: stub | openai_compatible   (default: stub)
HDV_LLM_PROVIDER="stub"
#
# For HDV_LLM_PROVIDER=openai_compatible (OpenAI-compatible Chat Completions API):
#   Base URL (include the version path). Examples:
#     OpenAI       https://api.openai.com/v1
#     Groq         https://api.groq.com/openai/v1
#     Together     https://api.together.xyz/v1
#     local vLLM   http://localhost:8000/v1
#     local Ollama http://localhost:11434/v1
# HDV_LLM_BASE_URL="https://api.openai.com/v1"
#   API key (optional for keyless local servers like vLLM/Ollama).
# HDV_LLM_API_KEY="sk-..."
#   Model id, e.g. gpt-4o-mini, llama-3.1-8b-instant, llama3.
# HDV_LLM_MODEL="gpt-4o-mini"

# --- Tenancy: BYOK + subscription model routing (tenancy/) ------------------------------
# The tenancy layer (config/models.json + tenancy/) picks a model for each tenant and decides
# HOW it is served/paid for. Two paths:
#   BYOK          — the tenant supplies their own OpenAI-compatible endpoint + key (see the
#                   Tenant.byokKeys field in code); HDV never uses a platform key for them.
#   subscription  — HDV-hosted, using the PLATFORM keys below. With none set, the deterministic
#                   offline StubProvider is used so everything still works with no network.
#
# Hostinger-hosted open models (hosting: hostinger in config/models.json):
# HDV_HOSTINGER_LLM_BASE_URL="https://<your-hostinger-llm-host>/v1"
# HDV_HOSTINGER_LLM_API_KEY="..."
#
# Cloud OpenAI-compatible models (hosting: cloud) reuse HDV_LLM_BASE_URL / HDV_LLM_API_KEY above.
#
# Optional local endpoint for free local models (hosting: local); if unset, the offline stub is
# used. Typically a keyless local server such as Ollama or vLLM:
# HDV_LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
# HDV_LOCAL_LLM_API_KEY=""

# --- Billing / metering (billing/) -----------------------------------------------------
# The PRODUCT metering layer turns APEX usage into a per-tenant, parameter-usage allowance
# with clear cost + occurrence metrics. It is fully offline: the default `demo` tenant runs
# in-memory with no database, and pricing is read from config/pricing.json.
#
# Path to the pricing table (default: config/pricing.json, resolved relative to the package):
# HDV_PRICING_PATH="config/pricing.json"
#
# Plan tier assigned to tenants that consume before an allowance is explicitly set:
#   FREE | STARTER | PRO | ENTERPRISE | BYOK   (default: FREE)
# HDV_BILLING_DEFAULT_TIER="FREE"
#
# Tenant that live APEX traffic (via the read-only dispatch observer) is attributed to
# (default: demo). Per-request tenancy on the gateway is selected with the X-HDV-Tenant header.
# HDV_BILLING_METER_TENANT="demo"
