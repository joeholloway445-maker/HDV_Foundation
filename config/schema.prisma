// Prisma schema for the Big 5 Matrix persistence layer.
//
// Phase 2 note: the running system still uses in-memory stores by default (APEX ledger,
// KNOLL audit, node registry, HOPE intent archive). The persistence/ layer now exposes
// repository interfaces (RequestLogRepository, NodeIdentityRepository,
// SecurityAuditRepository, IntentArchiveRepository) whose in-memory implementations
// mirror these models field-for-field. A Phase 4 Prisma-backed implementation can satisfy
// the same interfaces without touching call sites. This schema is the source of truth.

generator client {
  provider      = "prisma-client-js"
  // Runtime image is debian bookworm (OpenSSL 3). Builder may detect 1.1.x without
  // openssl installed — ship both so Docker and local hosts stay compatible.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every packet APEX attempts to route produces one RequestLog row (ledger).
model RequestLog {
  id             String   @id @default(uuid())
  packetId       String   @unique
  timestamp      DateTime @default(now())
  source         String
  destination    String
  status         String // 'SUCCESS', 'BLOCKED', 'FAILED'
  cost_usd       Decimal  @default(0.00)
  knollSignature String
}

/// One row per node in the 20,480-node fleet (ephemeral rows churn frequently).
model NodeIdentity {
  node_id      String   @id
  role         String
  status       String // 'ACTIVE', 'IDLE', 'TERMINATED'
  last_seen    DateTime @updatedAt
  is_ephemeral Boolean  @default(true)
}

/// KNOLL emits one SecurityAudit row per interception verdict.
model SecurityAudit {
  id        String   @id @default(uuid())
  packetId  String
  outcome   String
  reasoning String?
  timestamp DateTime @default(now())
}

/// HOPE documents one IntentDocument row per interpreted user intent (its documentation
/// layer). entities/goals/constraints are JSON-encoded string arrays in the durable store.
model IntentDocument {
  id                   String   @id @default(uuid())
  utterance            String
  kind                 String // 'SIMULATE','EXECUTE','QUERY','CLARIFY','DOCUMENT','UNKNOWN'
  entities             Json     @default("[]")
  goals                Json     @default("[]")
  constraints          Json     @default("[]")
  suggestedDestination String
  confidence           Float    @default(0)
  documentedAt         DateTime @default(now())
  clarificationNeeded  Boolean  @default(false)
}

/// Real account identity (auth/). One row per registered email+password account. NO email
/// verification and NO password-reset flow yet — both are deliberate follow-ups, not part of
/// this minimal-but-correct first pass (see auth/service.ts). `passwordHash` is never the raw
/// password: it is `scrypt` salt:hash (see auth/service.ts hashPassword/verifyPassword).
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A logged-in session token (auth/). One row per active login; `logout` deletes the row,
/// `getUserBySession` rejects (and lazily deletes) rows past `expiresAt`. Tokens are
/// cryptographically random (crypto.randomBytes) and used as-is as the primary key.
model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
