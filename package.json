{
  "name": "big5-matrix",
  "version": "0.2.0",
  "private": true,
  "description": "Big 5 Agent Hierarchy — Phase 2/3. Strict separation of concerns across HOPE, DREAM, VISION, KNOLL, APEX.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx demo/run_demo.ts",
    "demo:phase2": "tsx demo/run_phase2_demo.ts",
    "test": "node --import tsx --test tests/backbone.test.ts tests/phase2.test.ts tests/phase3.test.ts",
    "python:demo": "python3 personamatrix/demo.py",
    "python:scoring": "python3 colab/03_behavioral_scoring.py"
  },
  "keywords": [
    "big5",
    "agent-hierarchy",
    "apex",
    "knoll",
    "routing"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
