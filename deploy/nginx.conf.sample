# deploy/nginx.conf.sample — nginx reverse proxy for the HDV Foundation HOPE gateway.
#
# Alternative to Caddy (deploy/Caddyfile). Install into /etc/nginx/sites-available/hdv,
# symlink into sites-enabled, then obtain TLS with certbot (see deploy/HOSTINGER.md §6.3):
#
#   sudo cp deploy/nginx.conf.sample /etc/nginx/sites-available/hdv
#   sudo nano /etc/nginx/sites-available/hdv       # set server_name + upstream
#   sudo ln -s /etc/nginx/sites-available/hdv /etc/nginx/sites-enabled/hdv
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.yourdomain.com     # adds the TLS server block + auto-renew
#
# The gateway listens on 127.0.0.1:8787. nginx is the only public listener. /v1/health is
# always public; all other routes stay KNOLL-gated inside the gateway.

upstream hdv_gateway {
    server 127.0.0.1:8787;
    keepalive 16;
}

# Basic per-IP rate limit at the edge (the gateway also enforces HDV_RATE_LIMIT).
limit_req_zone $binary_remote_addr zone=hdv_api:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.com;

    # certbot will manage the TLS (443) block and add a redirect here automatically.
    # Until then, proxy plain HTTP so you can smoke-test:
    location / {
        limit_req zone=hdv_api burst=20 nodelay;

        proxy_pass         http://hdv_gateway;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    120s;   # long DREAM simulations
    }

    # Cheap, unauthenticated liveness probe.
    location = /v1/health {
        proxy_pass       http://hdv_gateway;
        access_log       off;
        proxy_set_header Host $host;
    }
}

# After `certbot --nginx` runs, it produces a 443 server block similar to:
#
